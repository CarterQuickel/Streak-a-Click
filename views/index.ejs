<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Build your clicking streak one tap at a time." />
  <title>Click-a-Streak</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <nav aria-label="Main navigation">
      <a class="brand" href="/">Click-a-Streak 🔥</a>
    </nav>
  </header>

  <main class="site-main">
    
    <section class="hero" aria-labelledby="page-title">
      <div class="num">
        <span id="clicks" style="user-select: none">0</span>
        <span id="str" data-strength="<%= str %>" style="--color: linear-gradient(to right, gray, gray);">+0</span>
      </div>
      <button class="btn">Click</button>
      <div class="streakCont">
        <div class="bars">
            <% streak.forEach((lvl, index) => { %>
                <progress id="progress" class="streakBar <%= lvl %>" data-value="<%= lvl %>" max="<%= (lvl*100) %>" value="0" aria-label="Streak progress">0%</progress>
            <% }); %>
        </div>
        <div id="streakNum" style="--scale: 14px;">🔥1x</div>
      </div>
      <div class="upgradeCont">
        <form action="/upgrade" method="POST">
          <button class="up" type="submit" id="streakUp">+1 Streak</button>
        </form>
        <button class="up" id="drainage">-2 Drainage (20)</button>
        <button class="up" id="force">+2 Force (100)</button>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <p>© <%= new Date().getFullYear() %> Clicker</p>
  </footer>

  <script src="/js/index.js" defer></script>
</body>
</html>